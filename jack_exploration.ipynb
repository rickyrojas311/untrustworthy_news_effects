    "# Extract the individual processed confidence dataframes before they were averaged\n",
    "conf_cols = [\"conf02\", \"conf05\", \"conf07\", \"conf08\", \"conf10\", \"conf11\", \"conf12\"]\n",
    "\n",
    "# Re-create the un-averaged numeric dataframe to test individual columns\n",
    "df_conf_numeric = df[conf_cols].map(lambda x: trust_mapping.get(str(x).strip(), np.nan))\n",
    "df_conf_numeric[\"ideo5_linear\"] = df[\"ideo5_linear\"]\n",
    "\n",
    "# Calculate correlations specifically against ideology\n",
    "ideo_correlations = df_conf_numeric.corr()[\"ideo5_linear\"].drop(\"ideo5_linear\")\n",
    "\n",
